APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=xyz
TYPESENSE_COLLECTION=documents
GOOGLE_DRIVE_CREDENTIALS_FILE=secrets/google-drive/credentials.json
GOOGLE_DRIVE_TOKEN_FILE=data/google-drive-token.json
# Facultatif : limite l'indexation aux fichiers enfants directs d'un dossier.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SOURCE_NAME=google-drive
GOOGLE_DRIVE_PAGE_SIZE=100
AI_PROVIDER=openai
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_MODEL=claude-sonnet-4-6
AI_MAX_INPUT_CHARS=20000
AI_MAX_OUTPUT_TOKENS=180
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NUXT_PUBLIC_API_BASE=http://localhost:8000/api
